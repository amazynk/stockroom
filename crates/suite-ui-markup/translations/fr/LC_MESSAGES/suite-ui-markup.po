msgid ""
"The download server couldn't be reached. Check your connection and try again."
msgstr ""
"Le serveur de téléchargement est injoignable. Vérifiez votre connexion et "
"réessayez."

#: crates/suite-ui/src/words.rs:155
msgid ""
"The download didn't match what the app list promised, so nothing was "
"installed."
msgstr ""
"Le téléchargement ne correspondait pas à ce que promettait la liste des "
"apps, donc rien n’a été installé."

#: crates/suite-ui/src/words.rs:157
msgid "The app list couldn't be checked, so nothing was changed."
msgstr "La liste des apps n’a pas pu être vérifiée, donc rien n’a été modifié."

#: crates/suite-ui/src/words.rs:158
msgid "{} can't be installed on this computer."
msgstr "{} ne peut pas être installé sur cet ordinateur."

#: crates/suite-ui/src/words.rs:159
msgid "There's no earlier version of {} to go back to."
msgstr "Il n’y a pas de version antérieure de {} à laquelle revenir."

#: crates/suite-ui/src/words.rs:160
msgid "Files couldn't be written. Check that the disk has free space."
msgstr ""
"Impossible d’écrire les fichiers. Vérifiez qu’il reste de la place sur le "
"disque."

#: crates/suite-ui/src/words.rs:161
msgid "Something went wrong with {}."
msgstr "Un problème est survenu avec {}."

#: crates/suite-ui/src/words.rs:170
msgid ""
"The app list couldn't be downloaded. Check your connection, then try again."
msgstr ""
"La liste des apps n’a pas pu être téléchargée. Vérifiez votre connexion, "
"puis réessayez."

#: crates/suite-ui/src/words.rs:172
msgid "The newest app list couldn't be checked. Showing the last known list."
msgstr ""
"La liste des apps la plus récente n’a pas pu être vérifiée. Affichage de la "
"dernière liste connue."

#: crates/suite-ui/src/words.rs:173
msgid ""
"The app list couldn't be checked, so nothing can be installed right now."
msgstr ""
"La liste des apps n’a pas pu être vérifiée, donc rien ne peut être installé "
"pour l’instant."

#~ msgid ""
#~ "Couldn't check for new versions: the server can't be reached. Showing the "
#~ "last known list."
#~ msgstr ""
#~ "Impossible de rechercher de nouvelles versions : le serveur est "
#~ "injoignable. Affichage de la dernière liste connue."

